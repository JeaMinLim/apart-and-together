# ==========================================
# Apart & Together — Multi-AI API Keys
# ==========================================
# 사용 중인 AI의 API 키만 입력하세요. 입력되지 않은 AI는 자동으로 건너뜁니다.

# 1. OpenAI (ChatGPT: gpt-4o, gpt-4o-mini 등)
OPENAI_API_KEY=

# 2. Anthropic (Claude: claude-3-5-sonnet, claude-3-haiku 등)
ANTHROPIC_API_KEY=

# 3. Google AI Studio (Gemini: gemini-1.5-pro, gemini-2.0-flash 등 - 무료 발급 가능)
GEMINI_API_KEY=

# 4. xAI (Grok: grok-2, grok-beta 등)
XAI_API_KEY=

# 5. OpenRouter (올인원 키: 모든 모델 접근 가능)
OPENROUTER_API_KEY=

# 6. Local LLM (Ollama) - 로컬 실행 시 기본값: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
